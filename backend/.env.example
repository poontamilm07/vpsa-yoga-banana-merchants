# Production MySQL Database Connection Credentials
SPRING_DATASOURCE_URL=jdbc:mysql://<mysql-host>:3306/bananaledger?useSSL=true&requireSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=<mysql-username>
SPRING_DATASOURCE_PASSWORD=<mysql-password>

# JWT Security Key
APP_JWT_SECRET=<strong-random-jwt-secret-min-32-chars>
APP_JWT_EXPIRATION_MS=86400000

# Server Port
PORT=8080
