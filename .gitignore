backend/data/
*.mv.db
*.trace.db

# IDE & Editor files
.idea/
.vscode/
*.iml
*.ipr
*.iws
.classpath
.project
.settings/

# OS / System files
.DS_Store
Thumbs.db
desktop.ini

# Log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
